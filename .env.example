# ─────────────────────────────────────────────────────────────────────────────
# BookNook client — copy to .env.local and fill in. NEVER commit .env.local.
# Only variables prefixed NEXT_PUBLIC_ are visible in the browser.
# ─────────────────────────────────────────────────────────────────────────────

# --- BetterAuth (server-side only) -------------------------------------------
# Random 32+ character secret. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of THIS Next.js app. It is also the JWT issuer/audience, so the Express
# server's BETTER_AUTH_URL must be exactly the same value.
#   local:       http://localhost:3000
#   production: https://<your-app>.vercel.app   (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# --- MongoDB Atlas (server-side only) -------------------------------------------
# Used by the BetterAuth MongoDB adapter (user, session, account, jwks collections).
# Atlas: Database > Connect > Drivers > copy the connection string, add a DB user,
# and allow your IP (and Vercel's) under Network Access.
MONGODB_URI=
# Use the same database name as the Express server's DB_NAME.
DB_NAME=booknook

# --- Google OAuth (server-side only, optional until you have credentials) --------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-app>.vercel.app/api/auth/callback/google
# Leave empty to hide Google sign-in errors during development: the button will show a toast.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Express API (public) -----------------------------------------------------------
#   local:       http://localhost:5000
#   production: https://<your-service>.onrender.com   (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- imgbb image upload (public key; used in a later phase) ----------------------
# https://api.imgbb.com/  > Get API key
NEXT_PUBLIC_IMGBB_API_KEY=
